{
  "name": "snarx-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first security sandbox, MCP proxy, and offline time-travel policy debugger for AI coding agents",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @snarx/web dev",
    "build": "pnpm -r build",
    "build:sandbox": "cargo build --release --manifest-path packages/sandbox-rs/Cargo.toml",
    "test": "pnpm -r test",
    "test:sandbox": "cargo test --manifest-path packages/sandbox-rs/Cargo.toml",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "lefthook": "^1.11.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
